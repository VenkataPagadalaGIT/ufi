# w3id.org/ufi -> ontology documents for the ufi project
Options +FollowSymLinks
RewriteEngine on

# Content negotiation for the NANP ontology
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [OR]
RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^nanp$ https://venkatapagadalagit.github.io/ufi/ontology/nanp.ttl [R=303,L]
RewriteRule ^nanp$ https://venkatapagadalagit.github.io/ufi/ontology/nanp.html [R=303,L]
RewriteRule ^nanp#?(.*)$ https://venkatapagadalagit.github.io/ufi/ontology/nanp.html#$1 [R=303,L]
RewriteRule ^(.*)$ https://github.com/VenkataPagadalaGIT/ufi [R=302,L]
